<tool name="herwig7-latest" version="@TOOL_VERSION@" revision="1">
  <lib name="HerwigLatestAPI"/>
  <client>
    <environment name="HERWIG_BASE" default="@TOOL_ROOT@"/>
    <environment name="LIBDIR" default="$HERWIG_BASE/lib/Herwig"/>
    <environment name="INCLUDE" default="$HERWIG_BASE/include"/>
    <environment name="BINDIR" default="$HERWIG_BASE/bin"/>
  </client>
  <runtime name="HERWIGLATESTPATH" value="$HERWIG_BASE/share/Herwig"/>
  <runtime name="ROOT_INCLUDE_PATH" value="$INCLUDE" type="path"/>
  <runtime name="PATH" default="$BINDIR" type="path"/>
  <use name="root_cxxdefaults"/>
  <use name="lhapdf"/>
  <use name="thepeg"/>
  <use name="madgraph5amcatnlo"/>
  <ifarchitecture name="!ppc64le">
    <use name="openloops"/>
  </ifarchitecture>
</tool>
