<tool name="thepeg-latest" version="@TOOL_VERSION@" revision="1">
  <lib name="ThePEG-latest"/>
  <lib name="LesHouches"/>
  <client>
    <environment name="THEPEG_BASE" default="@TOOL_ROOT@"/>
    <environment name="LIBDIR" default="$THEPEG_BASE/lib/ThePEG"/>
    <environment name="INCLUDE" default="$THEPEG_BASE/include"/>
  </client>
  <runtime name="THEPEGLATESTPATH" value="$THEPEG_BASE/share/ThePEG"/>
  <runtime name="ROOT_INCLUDE_PATH" value="$INCLUDE" type="path"/>
  <use name="root_cxxdefaults"/>
  <use name="lhapdf"/>
  <use name="gsl"/>
</tool>
